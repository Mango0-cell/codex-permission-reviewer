{
  "name": "codex-permission-reviewer",
  "version": "0.3.0",
  "description": "Configurable model review for sensitive Codex actions with privacy-preserving approval learning.",
  "type": "module",
  "bin": {
    "codex-permission-reviewer": "./bin/cli.mjs"
  },
  "files": [
    ".codex-plugin/",
    ".mcp.json",
    "bin/cli.mjs",
    "scripts/server.mjs",
    "scripts/app-server-client.mjs",
    "dist/bin/",
    "dist/scripts/",
    "dist/src/",
    "skills/",
    "LICENSE",
    "README.md",
    "docs/",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "codex",
    "model-review",
    "mcp",
    "permissions",
    "security"
  ],
  "author": "Adri\u00e1n Gait\u00e1n <hello@adriangaitan.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adriancho91s/codex-permission-reviewer.git"
  },
  "homepage": "https://github.com/adriancho91s/codex-permission-reviewer#readme",
  "bugs": {
    "url": "https://github.com/adriancho91s/codex-permission-reviewer/issues"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json && node dist/scripts/package-assets.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "prepare": "npm run build",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test:package": "node dist/scripts/verify-package.js"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "7.0.2"
  },
  "main": "./dist/scripts/server.js",
  "types": "./dist/scripts/server.d.ts"
}
